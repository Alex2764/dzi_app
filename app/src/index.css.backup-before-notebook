:root {
  --text: #3b4a63;
  --text-h: #0f2044;
  --bg: #eef4fd;
  --card-bg: #fff;
  --border: #dbe6f9;
  --accent: #2563eb;
  --accent-dark: #1d4ed8;
  --accent-bg: #e8f0fe;
  --done-bg: #dcfce7;
  --done-border: #86efac;
  --done-text: #14532d;
  --todo-bg: #eef3fb;
  --todo-text: #23385c;
  --wrong: #dc2626;
  --right: #16a34a;
  --shadow: 0 1px 2px rgba(15, 32, 68, 0.04), 0 6px 16px rgba(37, 99, 235, 0.07);

  font: 16px/150% system-ui, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  background: var(--bg);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

h1,
h2,
h3 {
  color: var(--text-h);
}

h1 {
  font-weight: 800;
  letter-spacing: -0.02em;
}

a {
  text-decoration: none;
  color: inherit;
}

.site-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 1px 2px rgba(15, 32, 68, 0.04);
}

.site-nav-inner {
  max-width: 880px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.site-nav-brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
  font-size: 17px;
  color: var(--accent);
  letter-spacing: -0.01em;
  white-space: nowrap;
}

.site-nav-links {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.site-nav-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease;
}

.site-nav-link:hover {
  background: var(--accent-bg);
  color: var(--accent-dark);
}

.site-nav-link.active {
  background: var(--accent);
  color: #fff;
}

.site-nav-signout {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: var(--text);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.site-nav-signout:hover {
  background: var(--accent-bg);
  color: var(--wrong);
}

.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: linear-gradient(135deg, #eef4fd, #dbeafe 60%, #eff6ff);
}

.auth-card {
  width: 100%;
  max-width: 360px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 32px 28px;
  border-radius: 16px;
  background: var(--card-bg);
  box-shadow: var(--shadow);
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
  font-size: 22px;
  color: var(--accent);
}

.auth-card .subtitle {
  margin: 0 0 8px;
}

.auth-card input {
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 16px;
  background: var(--card-bg);
  color: var(--text-h);
  transition: border-color 0.15s ease;
}

.auth-card input:focus {
  outline: none;
  border-color: var(--accent);
}

.auth-card .ai-btn {
  justify-content: center;
  margin-top: 4px;
}

.auth-switch {
  border: none;
  background: none;
  color: var(--accent);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  text-align: center;
  padding: 4px;
}

.auth-switch:hover {
  color: var(--accent-dark);
}

.ai-error {
  color: var(--wrong);
  margin: 0;
}

.subtitle-icon {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dashboard,
.topic-page {
  max-width: 880px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

.subtitle {
  color: var(--text);
  margin-bottom: 24px;
}

.level-section {
  margin-bottom: 36px;
}

.level-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  border-radius: 10px;
}

.topic-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
}

.topic-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 16px;
  border-radius: 10px;
  background: var(--todo-bg);
  color: var(--todo-text);
  font-weight: 700;
  border: 1px solid var(--border);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.topic-card:not(.disabled):hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
  border-color: var(--accent);
}

.topic-card.done {
  background: var(--done-bg);
  border-color: var(--done-border);
  color: var(--done-text);
}

.topic-card.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.topic-order {
  display: inline-flex;
  align-items: center;
  font-size: 13px;
  opacity: 0.7;
}

.topic-title {
  flex: 1;
}

.topic-title small {
  font-weight: 500;
  opacity: 0.75;
}

.check {
  display: inline-flex;
  color: var(--right);
}

.soon {
  font-size: 11px;
  font-weight: 400;
  opacity: 0.7;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 16px;
  color: var(--accent);
  font-weight: 600;
}

.badge-done {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-left: 12px;
  font-size: 14px;
  color: var(--right);
  vertical-align: middle;
}

.explanation {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}

.exercises {
  margin-bottom: 24px;
}

.exercise {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 0;
  flex-wrap: wrap;
}

.exercise.ai {
  flex-direction: row;
  flex-wrap: wrap;
}

.exercise.correct .ai-btn {
  border-color: var(--right);
  color: var(--right);
}

.exercise.incorrect .ai-btn {
  border-color: var(--wrong);
  color: var(--wrong);
}

.mark.ok {
  display: inline-flex;
  align-items: center;
  color: var(--right);
  font-weight: 700;
}

.mark.bad {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--wrong);
  font-weight: 700;
}

.ai-exercise {
  margin-top: 32px;
  padding: 20px;
  border-radius: 12px;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1px solid #bfdbfe;
  box-shadow: var(--shadow);
}

.ai-exercise h2 {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 0;
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border: none;
  border-radius: 10px;
  background: var(--accent);
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease;
}

.ai-btn:hover {
  background: var(--accent-dark);
}

.ai-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.ai-btn.secondary {
  background: #fff;
  color: var(--accent);
  border: 1px solid var(--accent);
  font-weight: 600;
}

.ai-btn.secondary:hover {
  background: var(--accent-bg);
}

.dashboard-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 24px;
}

.my-words-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 18px;
  border-radius: 10px;
  background: var(--accent);
  color: #fff;
  font-weight: 700;
  box-shadow: var(--shadow);
  transition: background 0.15s ease, transform 0.15s ease;
}

.my-words-link:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
}

.my-word-list {
  list-style: none;
  padding: 0;
  margin: 0 0 32px;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.my-word-list li {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--card-bg);
}

.my-word-list li:last-child {
  border-bottom: none;
}

.my-word-list .en {
  font-weight: 600;
  color: var(--text-h);
  min-width: 220px;
}

.my-word-list .bg {
  flex: 1;
  color: var(--text);
}

.flashcard-finished {
  margin: 24px 0;
  padding: 32px 24px;
  border-radius: 16px;
  background: var(--done-bg);
  border: 1px solid var(--done-border);
  text-align: center;
}

.flashcard-finished .flashcard-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  max-width: 340px;
  margin: 16px auto 0;
}

.page-transition {
  will-change: transform, opacity;
}

/* Теория (уроци) */
.theory {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px 24px;
  margin-bottom: 24px;
  box-shadow: var(--shadow);
}

.theory-definitions {
  margin: 0 0 20px;
}

.theory-definition {
  margin-bottom: 14px;
}

.theory-definition dt {
  font-weight: 700;
  color: var(--text-h);
}

.theory-definition dd {
  margin: 2px 0 0;
}

.theory-table-wrap {
  margin-bottom: 20px;
  overflow-x: auto;
}

.theory-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.theory-table th,
.theory-table td {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border);
}

.theory-table th {
  color: var(--text-h);
  background: var(--accent-bg);
}

.theory-note {
  background: var(--todo-bg);
  border-left: 3px solid var(--accent);
  border-radius: 6px;
  padding: 10px 14px;
  margin-bottom: 16px;
}

.theory-note-label {
  display: block;
  font-weight: 700;
  font-size: 13px;
  color: var(--accent-dark);
  margin-bottom: 2px;
}

.theory-note p {
  margin: 0;
}

.theory-list {
  margin-bottom: 4px;
}

.theory-list ul {
  margin: 6px 0 0;
  padding-left: 20px;
}

.theory-list li {
  margin-bottom: 4px;
}

.theory-text {
  margin: 0 0 16px;
}

.theory-code-wrap {
  position: relative;
  margin: 0 0 20px;
}

.theory-code {
  background: #0f2044;
  color: #dbe6f9;
  border-radius: 8px;
  padding: 14px 16px;
  margin: 0;
  overflow-x: auto;
  font-size: 13px;
  line-height: 1.5;
}

.theory-code code {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  white-space: pre;
}

.theory-code-copy {
  position: absolute;
  top: 8px;
  right: 8px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border: 1px solid rgba(219, 230, 249, 0.25);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  color: #dbe6f9;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.theory-code-copy:hover {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(219, 230, 249, 0.4);
}

.spin {
  animation: spin 1s linear infinite;
  vertical-align: -3px;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 720px) {
  .dashboard,
  .topic-page {
    padding: 20px 14px 60px;
  }

  .site-nav-inner {
    padding: 10px 14px;
  }

  h1 {
    font-size: 24px;
  }

  .topic-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-links {
    flex-direction: column;
  }

  .my-words-link {
    width: 100%;
    justify-content: center;
  }

  .my-word-list li {
    flex-wrap: wrap;
  }

  .my-word-list .en {
    min-width: 0;
  }
}
